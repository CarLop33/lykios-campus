# Lykios Campus
# Copia este archivo como .env.local solo en un entorno seguro.
# Nunca subas valores reales al repositorio.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
LYKIOS_VIDEO_SECRET=change-me-at-least-32-characters
LYKIOS_ADMIN_EMAIL=admin@example.com
LYKIOS_ADMIN_PASSWORD=change-me-at-least-14-characters
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxx

# Production
LYKIOS_APP_ORIGIN=https://campus.example.com
LYKIOS_PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx

# Optional overrides
LYKIOS_STORAGE_BACKEND=postgres
LYKIOS_FILE_BACKEND=blob
LYKIOS_MAIL_FROM=campus@example.com
LYKIOS_MAIL_FROM_NAME=Lykios Academy Campus
LYKIOS_MAIL_REPLY_TO=info@example.com
