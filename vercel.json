{
  "version": 2,
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/verify",
      "destination": "/api/verify"
    },
    {
      "source": "/verify/:path*",
      "destination": "/api/verify/:path*"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/courses",
      "destination": "/index.html"
    },
    {
      "source": "/course",
      "destination": "/index.html"
    },
    {
      "source": "/lesson",
      "destination": "/index.html"
    },
    {
      "source": "/profile",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ]
}
